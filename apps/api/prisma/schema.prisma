generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identity & Access
// ============================================================

enum Role {
  OWNER
  CHAIRMAN
  MANAGER
  MAINTENANCE
  ADMIN
}

enum Locale {
  SK
  CS
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  phone          String?
  passwordHash   String
  firstName      String
  lastName       String
  locale         Locale   @default(SK)
  seniorMode     Boolean  @default(false)
  totpSecret     String?
  totpEnabled    Boolean  @default(false)
  emailVerified  Boolean  @default(false)
  active         Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  totpRecoveryCodes TotpRecoveryCode[]
  pushSubscriptions PushSubscription[]
  classifieds    Classified[]
  notifications  NotificationReceipt[]
  createdTickets Ticket[]    @relation("TicketCreator")
  assignedTickets Ticket[]   @relation("TicketAssignee")
  auditEvents    AuditEvent[]
  paperVotes     VoteRecord[] @relation("PaperVoteRecorder")
  createdMeetings Meeting[]  @relation("MeetingCreator")
  meetingAttendance MeetingAttendance[]
  createdIncomingInvoices  IncomingInvoice[]           @relation("IncomingInvoiceCreator")
  uploadedInvoiceAttachments IncomingInvoiceAttachment[] @relation("IncomingInvoiceUploader")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  requestIp  String?

  @@index([userId])
}

/// Jednorazové záložné kódy pre TOTP (ak používateľ stratí telefón).
/// Každý sa dá použiť iba raz; pri použití sa markuje usedAt.
model TotpRecoveryCode {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String   @unique
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Web push (VAPID) subscription per device. Jeden user môže mať viac.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

// ============================================================
// Building structure
// ============================================================

model Building {
  id             String   @id @default(uuid())
  name           String
  address        String
  city           String
  zip            String
  country        String   @default("SK") // ISO-3166-1 alpha-2
  ico            String?  // IČO správcu / SVB
  legalForm      String?  // "SVB", "BD", "SVJ"
  totalShares    Decimal  @default(0) @db.Decimal(20, 6)

  // Fakturačné údaje — dosadené ako default na každú vystavenú faktúru.
  // Možno editovať per-budova v nastaveniach.
  billingName       String?  // Názov SVB / BD na faktúre (môže sa líšiť od `name`)
  billingIco        String?  // IČO odberateľa pri vystavovaní (zvyčajne = `ico`)
  billingDic        String?  // DIČ
  billingVatId      String?  // IČ DPH (ak je platca)
  billingAddress    String?  // Fakturačná adresa (môže sa líšiť od `address`)
  billingIban       String?  // Bankový účet pre prijímanie platieb
  billingBic        String?  // SWIFT/BIC
  billingBankName   String?  // Názov banky (UI helper)
  billingRegistry   String?  // Zápis v registri (napr. "Okresný úrad Bratislava III, OPS-…")
  invoiceNumberPrefix String? // Prefix evidenčného čísla (napr. "2026-FA-")
  invoiceFooterNote   String? // Pätička na PDF (napr. "SVB nie je platcom DPH")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  apartments     Apartment[]
  memberships    Membership[]
  votings        Voting[]
  tickets        Ticket[]
  documents      Document[]
  announcements  Announcement[]
  meters         Meter[]
  invoices       Invoice[]
  meetings       Meeting[]
  revisions      Revision[]
  classifieds    Classified[]
  suppliers      Supplier[]
  incomingInvoices IncomingInvoice[]

  @@index([country])
}

model Apartment {
  id             String   @id @default(uuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitNumber     String   // číslo bytu
  floor          Int?
  area           Decimal  @db.Decimal(10, 2)
  ownershipShare Decimal  @db.Decimal(20, 6) // podiel na spoločných častiach
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    Membership[]
  meters         Meter[]
  voteRecords    VoteRecord[]
  tickets        Ticket[]
  invoices       Invoice[]
  payments       Payment[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
}

model Membership {
  id             String   @id @default(uuid())
  // userId môže byť null kým aktivačný kód nie je uplatnený
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartmentId    String?
  apartment      Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  role           Role
  sharePercent   Decimal? @db.Decimal(10, 6) // spoluvlastnícky podiel v %
  verifiedAt     DateTime?
  activationCode String?  @unique // kód z vyúčtovania (po uplatnení sa nuluje)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, buildingId, apartmentId, role])
  @@index([buildingId])
  @@index([apartmentId])
}

// ============================================================
// Voting
// ============================================================

enum VotingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum VotingType {
  SIMPLE_MAJORITY      // nadpolovičná väčšina
  QUALIFIED_MAJORITY   // dvojtretinová väčšina
  UNANIMOUS            // jednomyseľné
}

enum VoteChannel {
  ELECTRONIC
  PAPER
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

model Voting {
  id              String       @id @default(uuid())
  buildingId      String
  building        Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  meetingId       String?
  meeting         Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  title           String
  description     String
  type            VotingType
  status          VotingStatus @default(DRAFT)
  opensAt         DateTime
  closesAt        DateTime
  quorumRequired  Decimal      @db.Decimal(5, 4) // napr. 0.5001 pre nadpolovičnú
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  records         VoteRecord[]
  result          VotingResult?

  @@index([buildingId])
  @@index([status])
  @@index([meetingId])
}

// Každý záznam = jeden hlas od jedného bytu. Môže byť elektronický aj listinný.
// Pravidlá (vyhodnocované v service vrstve pri uzávierke):
//  1. Ak pre (votingId, apartmentId) existuje aspoň jeden PAPER záznam,
//     použije sa NAJNOVŠÍ PAPER (listinný má prioritu).
//  2. Inak sa použije NAJNOVŠÍ ELECTRONIC pred closesAt.
model VoteRecord {
  id              String      @id @default(uuid())
  votingId        String
  voting          Voting      @relation(fields: [votingId], references: [id], onDelete: Cascade)
  apartmentId     String
  apartment       Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  channel         VoteChannel
  choice          VoteChoice
  castAt          DateTime    @default(now())
  // Pre elektronické: hash identifikujúci session (anti-replay).
  // Pre listinné: ID fyzického hárku a kto ho zapísal.
  electronicSessionHash String?
  paperBallotReference  String?
  recordedById    String?
  recordedBy      User?       @relation("PaperVoteRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  // Proxy voting (splnomocnenie): ak je prítomné, tento záznam je hlas za iný byt
  // vykonaný na základe písomného splnomocnenia (skan je v proxyDocumentKey).
  proxyFromApartmentId String?
  proxyDocumentKey     String?
  // Odtlačok hlasu pre právnu validitu (choice + castAt + predošlý hash).
  integrityHash   String
  prevHash        String?

  @@index([votingId, apartmentId, channel, castAt])
  @@index([proxyFromApartmentId])
}

model VotingResult {
  id              String   @id @default(uuid())
  votingId        String   @unique
  voting          Voting   @relation(fields: [votingId], references: [id], onDelete: Cascade)
  computedAt      DateTime @default(now())
  yesShares       Decimal  @db.Decimal(20, 6)
  noShares        Decimal  @db.Decimal(20, 6)
  abstainShares   Decimal  @db.Decimal(20, 6)
  totalShares     Decimal  @db.Decimal(20, 6)
  quorumReached   Boolean
  accepted        Boolean
  pdfStorageKey   String?  // PDF zápisnica uložená v S3/MinIO
  pdfSha256       String?
}

// ============================================================
// Tickets (hlásenie porúch)
// ============================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Ticket {
  id             String         @id @default(uuid())
  buildingId     String
  building       Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartmentId    String?
  apartment      Apartment?     @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  creatorId      String
  creator        User           @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeId     String?
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title          String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  attachments    TicketAttachment[]
  comments       TicketComment[]

  @@index([buildingId, status])
  @@index([assigneeId])
}

model TicketAttachment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  storageKey  String   // kľúč v MinIO
  mimeType    String
  sizeBytes   Int
  sha256      String
  uploadedAt  DateTime @default(now())
}

model TicketComment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  body        String
  createdAt   DateTime @default(now())
}

// ============================================================
// Documents
// ============================================================

enum DocumentCategory {
  CONTRACT
  INVOICE
  ANNUAL_REPORT
  TECHNICAL_REVIEW
  MEETING_MINUTES
  OTHER
}

model Document {
  id          String           @id @default(uuid())
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category    DocumentCategory
  title       String
  description String?
  storageKey  String
  mimeType    String
  sizeBytes   Int
  sha256      String
  uploadedBy  String
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime         @default(now())

  @@index([buildingId, category])
}

// ============================================================
// Announcements (digitálna nástenka)
// ============================================================

enum AnnouncementSeverity {
  INFO
  WARNING
  URGENT
}

model Announcement {
  id          String              @id @default(uuid())
  buildingId  String
  building    Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  authorId    String
  title       String
  body        String
  severity    AnnouncementSeverity @default(INFO)
  publishedAt DateTime            @default(now())
  expiresAt   DateTime?

  receipts    NotificationReceipt[]

  @@index([buildingId, publishedAt])
}

model NotificationReceipt {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  deliveredAt    DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// ============================================================
// Energy (IoT + EDC)
// ============================================================

enum MeterType {
  ELECTRICITY
  WATER_COLD
  WATER_HOT
  HEAT
  PV_PRODUCTION // výroba z fotovoltiky
}

model Meter {
  id           String      @id @default(uuid())
  buildingId   String
  building     Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartmentId  String?
  apartment    Apartment?  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  type         MeterType
  serialNumber String      @unique
  label        String?
  installedAt  DateTime?
  active       Boolean     @default(true)

  readings     EnergyReading[]

  @@index([buildingId, type])
}

// 15-minútové intervaly (EDC štandard)
model EnergyReading {
  id          String   @id @default(uuid())
  meterId     String
  meter       Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  intervalStart DateTime
  intervalEnd   DateTime
  // kWh alebo m3 – dostatočná presnosť pre vyúčtovanie
  value        Decimal  @db.Decimal(18, 6)
  quality      String?  // "MEASURED" | "ESTIMATED" | "SUBSTITUTED"

  @@unique([meterId, intervalStart])
  @@index([meterId, intervalStart])
}

// Alokácia zdieľanej zelenej energie z PV na jednotlivé byty v 15-min. okne.
model EnergyAllocation {
  id            String   @id @default(uuid())
  apartmentId   String
  intervalStart DateTime
  intervalEnd   DateTime
  allocatedKwh  Decimal  @db.Decimal(18, 6)
  // 0.0 - 1.0, koľko % PV produkcie pripadlo na tento byt v danom intervale
  sharePercent  Decimal  @db.Decimal(7, 6)
  createdAt     DateTime @default(now())

  @@unique([apartmentId, intervalStart])
  @@index([apartmentId, intervalStart])
}

// ============================================================
// Finance — faktúry / vyúčtovania / platby
// ============================================================

enum InvoiceCategory {
  MAINTENANCE_FUND   // fond opráv
  SERVICES           // zálohy na služby (teplo, voda, spoločná elektrina)
  MANAGEMENT_FEE     // odmena správcu
  ONE_TIME           // mimoriadna platba (napr. výťah)
  OTHER
}

enum InvoiceStatus {
  DUE
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id           String          @id @default(uuid())
  buildingId   String
  building     Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartmentId  String
  apartment    Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  number       String          // evidenčné číslo (napr. 2026-04-0042)
  category     InvoiceCategory
  period       String          // napr. "2026-04" alebo "2026-Q2"
  amount       Decimal         @db.Decimal(14, 2)
  currency     String          @default("EUR")
  issuedAt     DateTime        @default(now())
  dueDate      DateTime
  status       InvoiceStatus   @default(DUE)
  pdfStorageKey String?
  note         String?
  // QR code data pre SEPA/EPC platbu v mobile bankingu
  qrPaymentString String?
  payments     Payment[]

  @@unique([buildingId, number])
  @@index([apartmentId, status])
  @@index([buildingId, period])
}

model Payment {
  id           String   @id @default(uuid())
  apartmentId  String
  apartment    Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("EUR")
  paidAt       DateTime
  reference    String?  // VS / SS / KS
  source       String?  // "BANK_IMPORT", "MANUAL", ...
  createdAt    DateTime @default(now())

  @@index([apartmentId, paidAt])
  @@index([invoiceId])
}

// ============================================================
// Schôdze vlastníkov (valné zhromaždenia / shromáždenia)
// ============================================================

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Meeting {
  id           String         @id @default(uuid())
  buildingId   String
  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title        String
  scheduledAt  DateTime
  location     String?        // napr. "pivnica pri kočíkarni" alebo Zoom link
  agenda       String         // markdown/plain text body
  minutes      String?        // zápisnica po skončení
  minutesPdfKey String?
  status       MeetingStatus  @default(SCHEDULED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attendance   MeetingAttendance[]
  votings      Voting[]

  @@index([buildingId, scheduledAt])
}

model MeetingAttendance {
  id         String  @id @default(uuid())
  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartmentId String?
  rsvp       String? // "YES" | "NO" | "MAYBE"
  attended   Boolean @default(false)
  checkedInAt DateTime?

  @@unique([meetingId, userId])
  @@index([userId])
}

// ============================================================
// Revízie & preventívna údržba (zákonné termíny)
// ============================================================

enum RevisionType {
  BOILER          // kotol / plynové zariadenia
  ELEVATOR        // výťah
  CHIMNEY         // kominárske
  ELECTRICAL      // elektroinštalácia
  FIRE_SAFETY     // požiarna
  GAS             // plynovod
  LIGHTNING_ROD   // bleskozvod
  PLAYGROUND      // detské ihrisko
  OTHER
}

model Revision {
  id          String       @id @default(uuid())
  buildingId  String
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  type        RevisionType
  title       String
  dueDate     DateTime
  lastDoneAt  DateTime?
  intervalMonths Int?      // pre automatické plánovanie ďalšej (napr. 12)
  contractorName String?
  contractorPhone String?
  contractorEmail String?
  notes       String?
  reminderSentAt DateTime? // cron označí, aby neposielal pripomienku 2x
  completedAt DateTime?
  reportPdfKey String?     // nahratý protokol
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([buildingId, dueDate])
  @@index([dueDate])
}

// ============================================================
// Marketplace / burza (susedská)
// ============================================================

enum ClassifiedType {
  FOR_SALE       // predám
  WANTED         // hľadám
  GIVEAWAY       // zadarmo
  LOST_AND_FOUND // straty a nálezy
  PACKAGE        // "mám váš balík"
}

enum ClassifiedStatus {
  ACTIVE
  CLOSED
  REMOVED
}

model Classified {
  id          String           @id @default(uuid())
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type        ClassifiedType
  title       String
  body        String
  priceEur    Decimal?         @db.Decimal(10, 2)
  contactPhone String?
  contactApartment String?     // napr. "byt 17"
  status      ClassifiedStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  expiresAt   DateTime?        // default 60 dní

  @@index([buildingId, status, createdAt])
  @@index([authorId])
}

// ============================================================
// Marketing leads (z landing page formuláru)
// ============================================================

model Lead {
  id         String   @id @default(uuid())
  email      String
  phone      String?
  city       String?
  units      Int?
  source     String?  // "landing", "referral", ...
  note       String?
  status     String   @default("NEW") // NEW | CONTACTED | CONVERTED | LOST
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// ============================================================
// Audit (append-only s hash-reťazením)
// ============================================================

model AuditEvent {
  id          String   @id @default(uuid())
  occurredAt  DateTime @default(now())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String   // napr. "VOTING_CAST", "USER_LOGIN"
  resourceType String  // "Voting", "User", "Ticket", ...
  resourceId  String?
  payload     Json?
  ipAddress   String?
  userAgent   String?
  prevHash    String?
  hash        String   @unique

  @@index([occurredAt])
  @@index([resourceType, resourceId])
}

// ============================================================
// PRIJATÉ FAKTÚRY (faktúry od dodávateľov pre SVB/BD)
// ============================================================

enum IncomingInvoiceStatus {
  DRAFT      // pri uploade, kým sa nepotvrdia údaje (po OCR)
  PENDING    // potvrdená, čaká na úhradu
  APPROVED   // schválená výborom (nepovinné)
  PAID       // uhradená
  CANCELLED  // zrušená / nesprávne vystavená
}

/// Dodávateľ — opakujúce sa firmy ktoré fakturujú SVB.
/// Energie, údržba, výťahový servis, plynár, advokát, …
///
/// Ak je IČO známe, pri uploadu faktúry sa dodávateľ automaticky priradí.
/// Predseda nemusí udaje vypĺňať druhýkrát.
model Supplier {
  id          String   @id @default(uuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  ico         String?
  dic         String?
  vatId       String?  // IČ DPH
  iban        String?
  email       String?
  phone       String?
  address     String?
  category    String?  // voľný text — "Energie", "Výťah", "Komín", "Účtovníctvo", ...
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    IncomingInvoice[]

  @@unique([buildingId, ico])
  @@index([buildingId])
  @@index([buildingId, name])
}

model IncomingInvoice {
  id              String                @id @default(uuid())
  buildingId      String
  building        Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Údaje z faktúry (vyplnené ručne alebo OCR-om)
  invoiceNumber   String?               // číslo faktúry od dodávateľa
  variableSymbol  String?               // VS pre úhradu
  issueDate       DateTime?
  dueDate         DateTime?
  taxableDate     DateTime?             // dátum dodania
  amount          Decimal               @db.Decimal(14, 2)
  currency        String                @default("EUR")
  iban            String?               // kam zaplatiť (z faktúry)
  description     String?
  category        String?               // "Energie", "Výťah", "Materiál", ...
  status          IncomingInvoiceStatus @default(DRAFT)
  paidAt          DateTime?
  paidAmount      Decimal?              @db.Decimal(14, 2)
  paidNote        String?               // VS, source, manuálna poznámka

  // Meta
  createdById     String?
  createdBy       User?                 @relation("IncomingInvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ocrText         String?               // celý surový text z OCR (pre later regex / search)
  ocrConfidence   Decimal?              @db.Decimal(5, 4) // 0–1, ako spoľahlivo OCR rozpoznal

  attachments     IncomingInvoiceAttachment[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([buildingId, status])
  @@index([buildingId, dueDate])
  @@index([supplierId])
}

/// Príloha prijatej faktúry — fotky, PDF, sken.
/// Jedna faktúra môže mať viac príloh (napr. fotka + zoznam položiek).
model IncomingInvoiceAttachment {
  id              String          @id @default(uuid())
  invoiceId       String
  invoice         IncomingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storageKey      String
  filename        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  uploadedAt      DateTime        @default(now())
  uploadedById    String?
  uploadedBy      User?           @relation("IncomingInvoiceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ============================================================
// PHONE PAIRING (mobil ↔ desktop) — pre fotenie faktúr
// ============================================================

/// Predseda na PC vygeneruje QR kód → mobil ho naskenuje → otvorí URL
/// s tokenom → mobil môže nahrať fotky priamo do session na PC.
/// Token je krátkodobý (15 min), jednorazový pre konkrétny use case.
enum PhonePairingPurpose {
  INCOMING_INVOICE_PHOTO
  TICKET_PHOTO
  DOCUMENT_PHOTO
}

model PhonePairingSession {
  id          String              @id @default(uuid())
  token       String              @unique // pre URL: domovplus.sk/p/<token>
  purpose     PhonePairingPurpose
  buildingId  String
  // Voliteľne previazané na konkrétny resource (napr. ticketId, invoiceId).
  contextId   String?
  createdById String
  expiresAt   DateTime
  consumedAt  DateTime?           // kedy mobil prvýkrát uploadol
  // Zoznam storageKey-ov nahraných cez túto session (CSV)
  uploadedKeys String?

  createdAt   DateTime            @default(now())

  @@index([token])
  @@index([expiresAt])
}
