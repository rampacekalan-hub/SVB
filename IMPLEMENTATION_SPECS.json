            "OpenStreetMap Nominatim (free)",
            "MapBox Geocoding (optional fallback)"
          ],
          "acceptance": [
            "Autocomplete dropdown appears on input",
            "Results are formatted and normalized",
            "Address is parsed to city, zip, street",
            "Debounce prevents spam requests",
            "Results cached to reduce API calls",
            "Works offline with cache"
          ]
