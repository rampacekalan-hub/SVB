  "components_to_create": [
    {
      "name": "ApartmentTable.tsx",
      "path": "apps/web/src/components/ApartmentTable.tsx",
      "type": "Table Component",
      "props": {
        "apartments": "Apartment[]",
        "onEdit": "(id: string, data: Apartment) => void",
        "onDelete": "(id: string) => void",
        "onAdd": "() => void",
        "editable": "boolean"
      },
      "features": ["Inline editing", "Row actions", "Delete confirmation", "Add button"]
    },
    {
      "name": "ApartmentEditor.tsx",
      "path": "apps/web/src/components/ApartmentEditor.tsx",
      "type": "Modal Form",
      "props": {
        "apartment": "Apartment | null",
        "onSubmit": "(data: Apartment) => void",
        "onCancel": "() => void",
        "buildingId": "string"
      },
      "features": ["Edit form", "Validation", "Error handling"]
    },
    {
      "name": "IbanInput.tsx",
      "path": "apps/web/src/components/IbanInput.tsx",
      "type": "Input Component",
      "props": {
        "value": "string",
        "onChange": "(value: string) => void",
        "onValidate": "(valid: boolean) => void",
        "country": "'SK' | 'CZ'",
        "bicValue": "string",
        "onBicChange": "(bic: string) => void"
      },
      "features": ["Auto-formatting", "Real-time validation", "Error display", "BIC display"]
    },
    {
      "name": "AddressInput.tsx",
      "path": "apps/web/src/components/AddressInput.tsx",
      "type": "Autocomplete Component",
      "props": {
        "value": "string",
        "onChange": "(value: string) => void",
        "onSelect": "(address: AddressResult) => void",
        "country": "'SK' | 'CZ'"
      },
      "features": ["Autocomplete dropdown", "Debounce", "Caching", "Normalization"]
    },
    {
      "name": "ActivationCodesWizard.tsx",
      "path": "apps/web/src/components/ActivationCodesWizard.tsx",
      "type": "Multi-step Wizard",
      "props": {
        "building": "Building",
        "onComplete": "() => void"
      },
      "features": ["6 steps", "Progress indicator", "PDF generation", "Email delivery"]
    },
    {
      "name": "BuildingSettingsPage.tsx",
      "path": "apps/web/src/shells/BuildingSettingsPage.tsx",
      "type": "Page Component",
      "features": ["Tabs", "Role-based access", "Audit log", "Form validation"]
    }
  ],
  "backend_endpoints": [
    {
      "method": "PATCH",
      "path": "/buildings/:id/apartments/:aptId",
      "description": "Update apartment data",
      "auth": "USER",
      "body": {
        "unitNumber": "string",
        "firstName": "string",
        "lastName": "string",
        "email": "string",
        "shares": "decimal"
      },
      "response": "Apartment"
    },
    {
      "method": "DELETE",
      "path": "/buildings/:id/apartments/:aptId",
      "description": "Delete apartment",
      "auth": "USER (CHAIRMAN/MANAGER/ADMIN of building)",
      "response": "{ success: boolean }"
    },
    {
      "method": "POST",
      "path": "/buildings/:id/apartments",
      "description": "Create new apartment",
      "auth": "USER",
      "body": {
        "unitNumber": "string",
        "firstName": "string",
        "lastName": "string",
        "email": "string",
        "shares": "decimal"
      },
      "response": "Apartment"
    },
    {
      "method": "GET",
      "path": "/api/address/lookup",
      "description": "Lookup address with autocomplete",
      "query": {
        "query": "string",
        "country": "'SK' | 'CZ'"
      },
      "response": [
        {
          "displayName": "string",
          "address": "string",
          "city": "string",
          "zip": "string",
          "country": "string"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/bic/lookup",
      "description": "Lookup BIC by IBAN",
      "query": {
        "iban": "string"
      },
      "response": {
        "bic": "string",
        "bankName": "string",
        "country": "string"
      }
    },
    {
      "method": "POST",
      "path": "/buildings/:id/activation-codes/generate",
      "description": "Generate activation codes for all apartments",
      "auth": "USER (MANAGER of building)",
      "body": {
        "regenerate": "boolean (optional)"
      },
      "response": {
        "codesGenerated": "number",
        "existingCodes": "number | null"
      }
    },
    {
      "method": "GET",
      "path": "/buildings/:id/apartments",
      "description": "Get all apartments with optional codes",
      "query": {
        "include": "codes"
      },
      "response": "Apartment[]"
    },
    {
      "method": "POST",
      "path": "/buildings/:id/activation-codes/send-email",
      "description": "Send activation codes via email to apartment owners",
      "auth": "USER (MANAGER of building)",
      "body": {
        "apartmentIds": "string[]",
        "subject": "string",
        "template": "string"
      },
      "response": {
        "sent": "number",
        "failed": "number"
      }
    }
  ],
  "utilities_to_create": [
    {
      "file": "apps/api/src/utilities/iban.service.ts",
      "functions": [
        {
          "name": "validateIban",
          "params": ["iban: string"],
          "returns": "boolean",
          "description": "Validate IBAN using MOD97 check"
        },
        {
          "name": "formatIban",
          "params": ["iban: string"],
          "returns": "string",
          "description": "Format IBAN with spaces (SK00 XXXX XXXX…)"
        },
        {
          "name": "normalizeIban",
          "params": ["iban: string"],
          "returns": "string",
          "description": "Remove spaces and normalize to uppercase"
        }
      ]
    },
    {
      "file": "apps/api/src/utilities/address.service.ts",
      "functions": [
        {
          "name": "lookupAddress",
          "params": ["query: string", "country: 'SK' | 'CZ'"],
          "returns": "Promise<AddressResult[]>",
          "description": "Lookup addresses using Nominatim"
        },
        {
          "name": "normalizeAddress",
          "params": ["address: AddressResult"],
          "returns": "{ street, city, zip, country }",
          "description": "Normalize address format"
        }
      ]
    },
    {
      "file": "apps/api/src/utilities/bic.service.ts",
      "functions": [
        {
          "name": "lookupBic",
          "params": ["iban: string"],
          "returns": "Promise<{ bic: string, bankName: string }>",
          "description": "Lookup BIC by IBAN"
        },
        {
          "name": "getBankName",
          "params": ["bic: string"],
          "returns": "string | null",
          "description": "Get bank name by BIC code"
        }
      ]
    }
  ],
